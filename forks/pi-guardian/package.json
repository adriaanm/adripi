{
	"name": "pi-guardian",
	"version": "0.1.0",
	"private": false,
	"type": "module",
	"description": "Stateful automatic safety review for Pi tool calls",
	"keywords": [
		"pi-package",
		"pi-extension",
		"safety"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/andersonbcdefg/pi-guardian"
	},
	"license": "Apache-2.0",
	"files": [
		"src",
		"prompts",
		"LICENSES",
		"THIRD_PARTY_NOTICES.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	}
}
