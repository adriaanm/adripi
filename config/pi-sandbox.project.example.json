{
  "filesystem": {
    "allowUserTemp": true,
    "additionalAllowRead": [
      "/tmp/sgo-501",
      "/private/tmp/sgo-501"
    ],
    "additionalAllowWrite": [
      "/tmp/sgo-501",
      "/private/tmp/sgo-501"
    ]
  },
  "network": {
    "allowedDomains": ["127.0.0.1:5555"],
    "deniedDomains": [],
    "strictAllowlist": false,
    "allowLocalBinding": true,
    "allowUnixSockets": [
      "/tmp/sgo-501",
      "/private/tmp/sgo-501"
    ],
    "allowAllUnixSockets": false
  },
  "hostIPC": {
    "mode": "ask",
    "preflightCommandPrefixes": [
      "just ios-build-check",
      "just ios-interptest",
      "just ios-device",
      "just ios-device-build",
      "just ios-device-brews",
      "just ios-device-ble",
      "just ios-lifecycle",
      "just ios-smoke-sim",
      "just ios-preview",
      "just ios-brew-replay",
      "just ios-brew-active-preview",
      "xcrun devicectl",
      "xcrun simctl"
    ],
    "allowCommandPrefixes": [
      "just ios-bindings-test",
      "just ios-device-logs"
    ],
    "retryOnUnixSocketError": true
  }
}
