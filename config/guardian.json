{
  "enabled": true,
  "reviewer": {
    "model": "neuralwatt/nw-flash",
    "extensions": [
      "npm:@aliou/pi-neuralwatt@0.18.0"
    ],
    "thinking": "low",
    "timeoutMs": 90000,
    "maxAttempts": 3,
    "context": {
      "maxTokens": 32768,
      "targetTokens": 8192,
      "pruneAfter": 8,
      "maxDirectiveChars": 128000
    }
  },
  "exemptTools": [
    "read",
    "grep",
    "find",
    "ls"
  ],
  "policyPath": "~/.pi/agent/guardian-policy.md",
  "sandboxExceptions": {
    "allow": [],
    "defer": [],
    "deny": []
  },
  "permissions": {
    "agentDirWriteProjects": [
      "/Users/adriaan/g/adripi"
    ]
  }
}
