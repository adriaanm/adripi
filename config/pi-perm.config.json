{
  "version": 1,
  "activePermissionProfile": "workspace",
  "permissions": {
    "workspace": {
      "filesystem": {
        ":minimal": "read",
        ":workspace_roots": {
          ".": "write",
          ".git": "read",
          ".codex": "read",
          ".agents": "read",
          "**/*.env": "deny",
          ".env": "deny",
          ".env.*": "deny",
          ".git/hooks/**": "deny"
        }
      },
      "network": {
        "enabled": true,
        "allowLocalBinding": true
      }
    }
  },
  "tools": {
    "bash": {
      "mode": "enforce",
      "defaultAction": "allow",
      "wrapWithSrt": true,
      "srtBinary": "srt",
      "operations": {
        "block": [
          "rm -rf /",
          "rm -rf ~",
          "~/.ssh/",
          "gh auth token",
          ".git/hooks"
        ]
      }
    }
  }
}
