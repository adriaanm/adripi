+/** Host-IPC preflight prompts can persist the exact command prefix for this
+ * project. The option is deliberately absent for generic Unix-socket retries:
+ * those have no narrow, reviewable scope.
+ */
+function hostIpcHumanApproval(
+  ctx: ExtensionContext,
+  prefix: string,
+  hostIPC: HostIPCConfig,
+): HumanApproval {
+  return async (request, reason, signal) => {
+    if (!ctx.hasUI) return "deny";
+    if (request.surface !== "host-ipc") {
+      return humanApproval(ctx)(request, reason, signal);
+    }
+    const target = request.command ?? request.operation;
+    const always = `Always allow "${prefix}" for this project`;
+    const suffix = reason ? `\n${reason}` : "";
+    const selected = await ctx.ui.select(
+      `Sandbox approval required: ${request.operation} ${target}\nWarning: this command will run on the host outside the OS sandbox.${suffix}`,
+      ["Allow this exact operation once", always, "Deny"],
+      { signal },
+    );
+    if (selected === always) {
+      addProjectApproval(ctx.cwd, prefix);
+      const list = hostIPC.allowCommandPrefixes;
+      if (list !== undefined && !list.includes(prefix)) {
+        (list as string[]).push(prefix);
+      }
+      return "allow-once";
+    }
